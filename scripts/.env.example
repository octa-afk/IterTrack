# Credenciales y endpoints del simulador de telemetría (scripts/simulate_trucks.py)
# Copiar este archivo a scripts/.env y completar con cuentas demo locales.
# IMPORTANTE: usar solo cuentas de desarrollo o testing.
# Nunca crear estas cuentas con estas claves en producción.
#
# Este archivo se carga al importar el módulo, antes de leer API_URL/AUTH_URL,
# y nunca pisa variables ya definidas en el entorno del proceso (en un PaaS o
# contenedor, las variables del entorno tienen prioridad).
#
# API_USER/API_PASSWORD: envían telemetría (PUT /trucks/{id}/location).
# ADMIN_API_USER/ADMIN_API_PASSWORD: registran camiones y limpian recorridos
# (POST /trucks, DELETE /trucks/{id}/iter). Si se omiten, el simulador usa
# la cuenta de telemetría y esas operaciones fallarán con 403 si no es admin.

# Endpoints de la API. Si se omiten, apuntan a http://127.0.0.1:8000.
# En una demo desplegada, apuntar a la URL pública del servicio:
#   API_URL=https://mi-demo.onrender.com/trucks
#   AUTH_URL=https://mi-demo.onrender.com/auth/login
API_URL=http://127.0.0.1:8000/trucks
AUTH_URL=http://127.0.0.1:8000/auth/login

API_USER=demo
API_PASSWORD=cambiar_esta_clave_en_local
ADMIN_API_USER=admin
ADMIN_API_PASSWORD=cambiar_esta_clave_en_local

# Modo dispositivo (--mode device): el simulador aprovisiona un dispositivo
# simulado por camión y emite por POST /devices/ingest, igual que un ESP32.
# Los dispositivos propios se reconocen por este prefijo + el id del camión
# (por ejemplo SIM-001). El seed de demo usa el mismo prefijo por defecto.
SIMULATED_DEVICE_PREFIX=SIM
