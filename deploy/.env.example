# Variables para `docker compose` en la VM de la demo.
# Copiar a `.env` en el mismo directorio que `docker-compose.yml`.
#
# Ninguna de estas lineas va al repositorio: `.env` esta en .gitignore.

# --- Imagen publicada por GitHub Actions ---
IMAGE=ghcr.io/octa-afk/itertrack:latest

# --- Caddy: el dominio publico de la demo ---
# Tiene que apuntar (registro A) al IP de la VM antes del primer arranque.
# Con un dominio real, Caddy obtiene el certificado solo.
DOMAIN=demo.tudominio.me

# --- Postgres del compose ---
# El puerto no se publica; solo lo ve la red interna de Docker.
POSTGRES_DB=itertrack_db
POSTGRES_USER=itertrack
POSTGRES_PASSWORD=cambiar_esta_clave_larga

# La app habla con el servicio `postgres` de la red del compose.
DATABASE_URL=postgresql+psycopg2://itertrack:cambiar_esta_clave_larga@postgres:5432/itertrack_db

# --- Firma de tokens (minimo 32 caracteres) ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar_por_una_clave_de_64_caracteres

# --- Arranque del contenedor web ---
RUN_MIGRATIONS=true
BOOTSTRAP_PLATFORM=true
SEED_DEMO_ON_BOOT=true

# --- Dueno de la plataforma (NO es la cuenta de la demo) ---
# Esta contrasena nunca se publica.
PLATFORM_ORG_NAME=IterTrack
PLATFORM_ADMIN_USERNAME=owner
PLATFORM_ADMIN_EMAIL=owner@tudominio.me
PLATFORM_ADMIN_FULL_NAME=Platform Owner
PLATFORM_ADMIN_PASSWORD=cambiar_esta_clave_de_plataforma

# --- Tenant de demo (estas credenciales SI son publicas) ---
DEMO_ORG_NAME=Demo Corp
DEMO_ADMIN_USERNAME=demo-admin
DEMO_ADMIN_EMAIL=demo-admin@tudominio.me
DEMO_ADMIN_FULL_NAME=Demo Admin
DEMO_ADMIN_PASSWORD=demo-admin-2026
DEMO_MEMBER_USERNAME=demo
DEMO_MEMBER_EMAIL=demo@tudominio.me
DEMO_MEMBER_FULL_NAME=Demo User
DEMO_MEMBER_PASSWORD=demo-2026

# --- Flota simulada del worker ---
# Tienen que coincidir con los del seed; el compose los pasa al simulador.
DEMO_TRUCK_COUNT=3
DEMO_TRUCK_BASE_ID=1
DEMO_TRUCK_BASE_PLATE=ABC123
DEMO_DEVICE_PREFIX=SIM
SIMULATED_DEVICE_PREFIX=SIM

# --- Credenciales del worker del simulador ---
# Usa la cuenta de administracion de la demo para aprovisionar dispositivos.
ADMIN_API_USER=demo-admin
ADMIN_API_PASSWORD=demo-admin-2026
