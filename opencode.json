{
  "mcp": {
    "servers": {
      "playwright-local": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--isolated",
          "--headless",
          "--allowed-origins=http://localhost:8000;http://127.0.0.1:8000",
          "--allowed-hosts=localhost,127.0.0.1",
          "--caps=devtools,network"
        ]
      }
    }
  }
}