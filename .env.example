# Configuración de IterTrack
# Copiar este archivo a `.env` (gitignored) y completar los valores.
#
# DATABASE_URL acepta tres formatos; el dialecto `postgresql+psycopg2://` es el
# que exige SQLAlchemy con psycopg2. Los formatos que entregan los PaaS
# (`postgres://` y `postgresql://`) se normalizan solos al arrancar.
#
#   Local:   postgresql+psycopg2://usuario:password@localhost:5432/itertrack_db
#   Render:  postgres://usuario:password@host:5432/itertrack_db
#   Railway: postgresql://postgres:password@host:5432/railway
DATABASE_URL=postgresql+psycopg2://usuario:password_seguro@localhost:5432/itertrack_db

# Clave para firmar y verificar los JWT (HS256). OBLIGATORIA, mínimo 32
# caracteres: con una clave corta cualquiera puede falsificar un token de admin.
# Generar una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=clave_secreta_generica_para_desarrollo_cambiar_en_produccion

# Algoritmo de firma y vigencia del access token en minutos.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
