# Configuración de base de datos para IterTrack
# Formato: postgresql+psycopg2://<usuario>:<contraseña>@<host>:<puerto>/<nombre_db>
DATABASE_URL=postgresql+psycopg2://usuario:password_seguro@localhost:5432/itertrack_db

# Clave secreta para tokens y seguridad (si se implementa autenticación)
SECRET_KEY=clave_secreta_generica_para_desarrollo_cambiar_en_produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Credenciales del simulador de telemetría (scripts/simulate_trucks.py)
# Usar SOLO una cuenta demo local o de testing. Nunca crear esta cuenta en producción.
API_USER=demo
API_PASSWORD=cambiar_esta_clave_en_local
