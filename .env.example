# Configuración de IterTrack
# Copiar este archivo a `.env` (gitignored) y completar los valores.
#
# DATABASE_URL acepta tres formatos; el dialecto `postgresql+psycopg2://` es el
# que exige SQLAlchemy con psycopg2. Los formatos que entregan los PaaS
# (`postgres://` y `postgresql://`) se normalizan solos al arrancar.
#
#   Local:   postgresql+psycopg2://usuario:password@localhost:5432/itertrack_db
#   Render:  postgres://usuario:password@host:5432/itertrack_db
#   Railway: postgresql://postgres:password@host:5432/railway
DATABASE_URL=postgresql+psycopg2://usuario:password_seguro@localhost:5432/itertrack_db

# Clave para firmar y verificar los JWT (HS256). OBLIGATORIA, mínimo 32
# caracteres: con una clave corta cualquiera puede falsificar un token de admin.
# Generar una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=clave_secreta_generica_para_desarrollo_cambiar_en_produccion

# Algoritmo de firma y vigencia del access token en minutos.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Bootstrap de plataforma (scripts/bootstrap_platform.py) ---
# Se corre UNA sola vez por despliegue. Crea la organización interna y tu cuenta
# de dueño de la plataforma. No lo toca el reset de la demo.
PLATFORM_ORG_NAME=IterTrack
PLATFORM_ADMIN_USERNAME=owner
PLATFORM_ADMIN_EMAIL=owner@itertrack.local
PLATFORM_ADMIN_FULL_NAME=Platform Owner
# Mínimo 12 caracteres. NUNCA la commitees: va solo en el panel del host.
PLATFORM_ADMIN_PASSWORD=cambiar_esta_clave_de_plataforma

# --- Seed de demo (scripts/seed_demo.py) ---
# Se puede rebarrer con `--reset` sin tocar tu cuenta de plataforma.
# Estas credenciales son públicas: se muestran en el login de la demo.
DEMO_ORG_NAME=Demo Corp
DEMO_ADMIN_USERNAME=demo-admin
DEMO_ADMIN_EMAIL=demo-admin@itertrack.local
DEMO_ADMIN_FULL_NAME=Demo Admin
DEMO_ADMIN_PASSWORD=cambiar_esta_clave_demo_admin
DEMO_MEMBER_USERNAME=demo
DEMO_MEMBER_EMAIL=demo@itertrack.local
DEMO_MEMBER_FULL_NAME=Demo User
DEMO_MEMBER_PASSWORD=cambiar_esta_clave_demo_member
DEMO_TRUCK_COUNT=3
DEMO_TRUCK_BASE_ID=1
# Patente de cada camión, en orden de id. Distintas entre sí para poder buscarlas
# por patente. El seed y el simulador leen la misma lista, así no divergen.
TRUCK_PLATES=ABC123,DEF456,XYZ789
# Sólo se usa si `TRUCK_PLATES` tiene menos patentes que camiones.
DEMO_TRUCK_BASE_PLATE=ABC123
DEMO_DEVICE_PREFIX=SIM

# Geocoding de direcciones (destinos de viaje).
# none: no se llama a ningún proveedor; cada destino queda "pendiente de ubicar"
#       y se resuelve con un pin manual. Es el default y el modo seguro.
# nominatim: OpenStreetMap. La instancia pública limita a 1 request/segundo y
#       4 requests/minuto para scripts periódicos. Para producción, instancia
#       propia o un proveedor hosted (ver odd/tasks/destinations.md).
GEOCODER_PROVIDER=none
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=IterTrack/1.0 (fleet telemetry; contacto@itertrack.local)

# Ruteo por calles (recorrido del viaje en el mapa).
# none: el mapa dibuja una línea recta entre destinos. Es el default.
# osrm: calcula la ruta real desde la posición del camión hasta las paradas
#       pendientes. La instancia pública es solo para la demo; en producción
#       apuntá ROUTING_URL a una instancia propia (sin SLA ni límite publicado).
ROUTING_PROVIDER=none
ROUTING_URL=https://router.project-osrm.org
